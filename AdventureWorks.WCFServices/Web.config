<configuration>
  <configSections>
  </configSections>
  <connectionStrings>
    <add name="AdventureWorks2025"
      connectionString="Data Source=(server);Initial Catalog=AdventureWorks2025;Integrated Security=True;Encrypt=False;TrustServerCertificate=True"
      providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="aspnet:UseTaskFriendlySynchronizationContext" value="true"/>
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8"/>
    <httpRuntime targetFramework="4.8"/>
  </system.web>
  <system.serviceModel>
    <behaviors>
      <serviceBehaviors>
        <behavior>
          <serviceMetadata httpGetEnabled="true" httpsGetEnabled="true"/>
          <serviceDebug includeExceptionDetailInFaults="true"/>
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <!-- ⭐ Optional binding block -->
    <bindings>
      <basicHttpBinding>
        <binding name="BasicHttpBinding_WCFServices" maxReceivedMessageSize="65536" allowCookies="true"/>
      </basicHttpBinding>
    </bindings>
    <services>

      <!-- Person Service -->
      <service name="AdventureWorks.WCFServices.PersonService">
        <endpoint address="" binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_WCFServices"
                  contract="AdventureWorks.WCFServices.IPersonService" />
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange" />
      </service>

      <!-- Product Service -->
      <service name="AdventureWorks.WCFServices.ProductService">
        <endpoint address="" binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_WCFServices"
                  contract="AdventureWorks.WCFServices.IProductService" />
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange" />
      </service>

      <!-- WorkOrder Service -->
      <service name="AdventureWorks.WCFServices.WorkOrderService">
        <endpoint address="" binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_WCFServices"
                  contract="AdventureWorks.WCFServices.IWorkOrderService" />
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange" />
      </service>

    </services>

    <protocolMapping>
      <add binding="basicHttpsBinding" scheme="https"/>
    </protocolMapping>
    <serviceHostingEnvironment aspNetCompatibilityEnabled="true" multipleSiteBindingsEnabled="true"/>
  </system.serviceModel>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true"/>
    <directoryBrowse enabled="true"/>
  </system.webServer>
  <!--<entityFramework>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>-->
</configuration>